{
  "name": "harvard-lil",
  "version": "1.0.0",
  "description": "Harvard Library Innovation Lab Website",
  "main": "assets/javascripts/main.js",
  "scripts": {
    "css:build": "postcss assets/css/main.css -o ../build/assets/css/main.css",
    "css:watch": "postcss assets/css/main.css -o ../build/assets/css/main.css --watch",
    "start": "npm run css:build && npx concurrently \"npm run css:watch\" \"npx @11ty/eleventy --serve\"",
    "build": "npm run css:build && npx @11ty/eleventy",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/harvard-lil/website-static.git"
  },
  "author": "Harvard LIL",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/harvard-lil/website-static/issues"
  },
  "homepage": "https://github.com/harvard-lil/website-static#readme",
  "dependencies": {
    "@11ty/eleventy": "^3.0.0",
    "autoprefixer": "^10.4.19",
    "concurrently": "^9.1.0",
    "luxon": "^3.5.0",
    "markdown-it": "^14.1.0",
    "postcss": "^8.4.45",
    "postcss-cli": "^11.0.0",
    "postcss-import": "^16.1.0",
    "postcss-scss": "^4.0.9",
    "tailwindcss": "^3.4.3"
  }
}
