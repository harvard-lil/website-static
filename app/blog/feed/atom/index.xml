---
---
<?xml version="1.0" encoding="utf-8"?>
<feed xmlns="http://www.w3.org/2005/Atom" {% if site.lang %}xml:lang="{{ site.lang }}"{% endif %}>
  <link href="{{ page.url | absolute_url }}" rel="self" type="application/atom+xml" />
  <link href="{{ '/' | absolute_url }}" rel="alternate" type="text/html" {% if site.lang %}hreflang="{{ site.lang }}" {% endif %}/>
  <updated>{{ "now" | date_to_xmlschema }}</updated>
  <id>{{ '/' | absolute_url | xml_escape }}</id>

  {% if site.title %}
    <title type="html">{{ site.title | smartify | xml_escape }}</title>
  {% elsif site.name %}
    <title type="html">{{ site.name | smartify | xml_escape }}</title>
  {% endif %}

  {% if site.description %}
    <subtitle>{{ site.description | xml_escape }}</subtitle>
  {% endif %}

  {% for post in collections.posts limit: 10 %}
    <entry{% if post.data.lang %}{{" "}}xml:lang="{{ post.data.lang }}"{% endif %}>
      <title type="html">{{ post.data.title | smartify | strip_html | normalize_whitespace | xml_escape }}</title>
      <link href="{{ post.url | absolute_url }}" rel="alternate" type="text/html" title="{{ post.data.title | xml_escape }}" />
      <published>{{ post.date | date_to_xmlschema }}</published>
      <updated>{{ post.data.last_modified_at | default: post.date | date_to_xmlschema }}</updated>
      {% if post.data.wordpress_id %}
        {% assign post_id = site.url | append: "/blog/?p=" | append: post.data.wordpress_id %}
        <id>{{ post_id | xml_escape }}</id>
      {% else %}
        <id>{{ post.url | absolute_url | xml_escape }}</id>
      {% endif %}

      <content type="html" xml:base="{{ post.url | absolute_url | xml_escape }}">
        <![CDATA[{{ post.templateContent }}]]>
      </content>

      <author>
      {% if post.data.author %}
          {% assign person_record = people[post.data.author] %}
          <name>{{ person_record.name | xml_escape }}</name>
      {% elsif post.data["guest-author"] %}
          <name>{{ post.data["guest-author"] | xml_escape }}</name>
      {% endif %}
      </author>

      {% for category in post.data.categories %}
        <category term="{{ category | xml_escape }}" />
      {% endfor %}

      {% for tag in post.data.tags %}
        <category term="{{ tag | xml_escape }}" />
      {% endfor %}

      {% if post.data.excerpt and post.data.excerpt != empty %}
        <summary type="html">
          <![CDATA[{{ post.data.excerpt | liquify | markdownify }}]]>
        </summary>
      {% endif %}

    </entry>
  {% endfor %}
</feed>
