---
permalink: /blog/feed/index.xml
---
<?xml version="1.0" encoding="UTF-8"?><rss version="2.0"
    xmlns:content="http://purl.org/rss/1.0/modules/content/"
    xmlns:wfw="http://wellformedweb.org/CommentAPI/"
    xmlns:dc="http://purl.org/dc/elements/1.1/"
    xmlns:atom="http://www.w3.org/2005/Atom"
    xmlns:sy="http://purl.org/rss/1.0/modules/syndication/"
    xmlns:slash="http://purl.org/rss/1.0/modules/slash/"
    >

<channel>
    <title>{{ site.blog_feed_title | xml_escape }}</title>
    <atom:link href="{{ site.url }}{{ page.url | remove: 'index.xml' }}" rel="self" type="application/rss+xml" />
    <link>{{ site.url }}/blog/</link>
    <description>{% if site.description %}{{ site.description | xml_escape }}{% endif %}</description>
    <language>en-US</language>
    {% for post in collections.posts reversed %}
    <item>
        <title>{{ post.data.title | xml_escape }}</title>
        <link>{{ site.url }}{{ post.url }}</link>
        <pubDate>{{ post.date | date_to_rfc822 }}</pubDate>
        {% if post.data.author %}
            {% assign person_record = people[post.data.author] %}
            <dc:creator><![CDATA[{{ person_record.name }}]]></dc:creator>
        {% elsif post.data["guest-author"] %}
            <dc:creator><![CDATA[{{ post.data["guest-author"] }}]]></dc:creator>
        {% endif %}
        {% if post.data.wordpress_id %}
            <guid isPermaLink="false">{{ site.url }}/blog/?p={{ post.data.wordpress_id }}</guid>
        {% else %}
            <guid isPermaLink="true">{{ site.url }}{{ post.url }}</guid>
        {% endif %}
        {% assign post_excerpt = post | post_excerpt %}
        {% if post_excerpt %}
            <description><![CDATA[{{ post_excerpt }}]]></description>
        {% endif %}
        <content:encoded><![CDATA[{{ post.templateContent }}]]></content:encoded>
    </item>
    {% endfor %}

    </channel>
</rss>
